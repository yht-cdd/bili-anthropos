    "linkedom": "^0.18.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.541",
    "sharp": "^0.35.5",
    "three": "0.178.0"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.178.1",
    "typescript": "5.9.3"
