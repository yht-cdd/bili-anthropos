{
  "baseUrl": "https://api.agnes-ai.cn",
  "keyFile": "secrets/agnes_key.txt",
  "modelsPath": "/v1/models",
  "image": {
    "path": "/v1/images/generations",
    "model": "agnes-image-2.5-flash",
    "size": "1920x1080",
    "extraBody": {
      "response_format": "url"
    }
  },
  "video": {
    "path": "/v1/videos",
    "model": "agnes-video-2.5-flash",
    "modeField": "mode",
    "modes": {
      "text": "text",
      "keyframe": "keyframe"
    },
    "statusPaths": [
      "/v1/videos/{id}",
      "/v1/videos/query?id={id}"
    ]
  },
  "dailyMaxUnlimited": true
}