{
  "name": "anthropos-video",
  "version": "1.0.0",
  "private": true,
  "description": "Anthropos 的视频渲染工程（Remotion）。跑在 GitHub Actions ubuntu-latest，4 vCPU / 16 GB。",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts AnthroposVideo out/video.mp4",
    "still": "remotion still src/index.ts AnthroposVideo out/frame.png --frame=45"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.6.0"
  }
}
